# 环境变量模板（不是必填清单，按需取用）
#
# 用法：复制为 server/.env 后修改。.env 已被 .gitignore 忽略，不会进仓库。
#
#   cp server/.env.example server/.env
#
# 加载方式：server/package.json 的 dev / start 脚本带了 --env-file-if-exists=.env，
# 所以 `npm run dev` 会自动读取 server/.env。文件不存在也能正常启动。
#
# 优先级：shell 里显式导出的环境变量 > .env 文件 > 代码里的默认值。
# 想临时覆盖某个值，直接在命令前加前缀即可，不用改文件：
#
#   PORT=3002 npm run dev:server
#
# 本文件分两段：
#   ① 最小可用   —— 只有几行，实际生效，看完就能跑
#   ② 完整参考   —— 全部是注释，只是「菜单」，需要哪个再取消注释


# ══════════════════════════════════════════════════════════════════════
# ① 最小可用
# ══════════════════════════════════════════════════════════════════════
#
# 【默认：只用 Mock /api/llm/v1】零成本、不需要任何 Key。
# 下面这行就是默认状态。其实这个文件整个不建也能跑，
# 因为所有变量在代码里都有默认值 —— 建它只是为了显式写清楚。
ENABLE_LLM_UPSTREAM=false

# 【要用真实 DeepSeek /api/llm-real/v1】需要改两处：
#   1) 把上面那行的 false 改成 true
#   2) 把下面 3 行取消注释，并填上真实 Key
#
# LLM_UPSTREAM_DEEPSEEK_KEY=sk-把这里换成你的真实Key
# LLM_UPSTREAM_DEEPSEEK_BASE=https://api.deepseek.com
# LLM_UPSTREAM_DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
#
# 改完需要重启服务端（重启后可在「大模型控制台 → 真实上游状态」里确认）


# ══════════════════════════════════════════════════════════════════════
# ② 完整参考
#
# 以下所有行都以 # 开头，都是注释，全都不生效，不需要整段复制。
# 需要调哪个，就把对应那一行的 # 去掉。每行上面都写了默认值，
# 看默认值就知道「省掉会怎样」。
# ══════════════════════════════════════════════════════════════════════

# ────────────────────────────── 基础 ──────────────────────────────

# 服务端口
# 默认 3001
# PORT=3001

# 登录会话数上限，超出后淘汰最旧的会话（压「登录风暴」时会被打到）
# 默认 10000
# SESSION_LIMIT=10000

# ────────────────────────── 数据量保护上限 ──────────────────────────
# 防止 generate 接口把内存写爆。压测要观察「数据量增长后的性能衰减」时，
# 需要把这两个值调大，否则会先撞上限而不是撞性能瓶颈。

# 用户数上限
# 默认 1000
# MAX_USERS=1000

# 商品数上限
# 默认 1000
# MAX_PRODUCTS=1000

# ──────────────────────────── 故障注入 ────────────────────────────

# 是否启用延迟注入中间件（请求头 / 查询参数触发）
# 默认 true
# ENABLE_DELAY_INJECTION=true

# 下单的「超卖竞态窗口」，单位毫秒。
# 默认 0（并发安全）。设为 >0 会在「校验库存」与「扣减库存」之间插入 await，
# 用来复现超卖（库存被扣成负数），做并发正确性测试。
# ORDER_RACE_WINDOW_MS=0

# 是否启用服务端自我压测接口 POST /perf/stress
# 默认 true。它会自己再发请求、放大负载，压测时建议关掉，改用外部工具
# ENABLE_PERF_STRESS=true

# ─────────────────────── 大模型 Mock（/api/llm/v1） ───────────────────────
# 零成本、无需真实 API Key，可注入错误 / 长尾延迟 / 截断。

# Mock 是否要求登录
# 默认 false。故意默认关闭，方便把「纯服务端容量」与「带鉴权开销」分开测
# ENABLE_LLM_AUTH=false

# Mock 的首 token 延迟基准，单位毫秒
# 默认 20
# LLM_TTFT_MS=20

# Mock 的相邻 token 间隔，单位毫秒（决定输出速度）
# 默认 2
# LLM_TOKEN_INTERVAL_MS=2

# Mock 注入 error=timeout 时，服务端挂住多久才断开，单位毫秒
# 默认 30000
# LLM_TIMEOUT_MS=30000

# ─────────────────── 真实上游透传（/api/llm-real/v1） ───────────────────
# ⚠️ 会产生真实费用。默认整体关闭，必须显式开启。
#
# 总开关与 Key / BASE / MODELS 的最小配置见文件顶部 ①，这里不再重复，
# 避免同一个键在两处出现（重复时后者会覆盖前者，容易排查不清）。
# 下面只列 ① 里没有的细调项：

# 默认上游的名字。不设时优先级：第一个（按字母序）
# LLM_UPSTREAM_DEFAULT=deepseek

# 单次请求的 max_tokens 硬上限（全局，防止误用烧钱）
# 默认 1024
# LLM_UPSTREAM_MAX_TOKENS=1024

# 上游超时，单位毫秒
# 默认 120000
# LLM_UPSTREAM_TIMEOUT_MS=120000

# 强制关闭思考模式（thinking）
# 默认 true。开着会让 completion_tokens 虚高、TTFT 量到思考首 token、成本翻几倍
# 调用时加 ?thinking=enabled 可单独覆盖
# LLM_UPSTREAM_DISABLE_THINKING=true

# ── 多上游：按命名约定自动发现，加一个供应商就是加三行 ──
# 格式：LLM_UPSTREAM_<名字>_KEY / _BASE / _MODELS
# <名字> 必须是大写字母与数字，服务里会转成小写作为路径段：
#   POST /api/llm-real/v1/<名字>/chat/completions
#
# DeepSeek 是默认供应商，配置见顶部 ①；再接一个就用下面这种写法：

# 再加一个 OpenAI
# LLM_UPSTREAM_OPENAI_KEY=sk-yyy
# LLM_UPSTREAM_OPENAI_BASE=https://api.openai.com/v1
# LLM_UPSTREAM_OPENAI_MODELS=gpt-4o-mini

# 旧写法（不带名字），会注册成名为 default 的上游，仍然兼容
# LLM_UPSTREAM_KEY=sk-zzz
# LLM_UPSTREAM_BASE=https://api.deepseek.com
# LLM_UPSTREAM_MODELS=deepseek-flash,deepseek-v4-pro
